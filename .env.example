# Frontend (apps/web/.env.local)
# WebSocket/HTTP server URL — no trailing slash
VITE_SERVER_URL=http://localhost:8787

# Production example:
# VITE_SERVER_URL=https://ludo-arena-server.2mrvenkatesh.workers.dev

# Server (wrangler.toml vars section, or wrangler secret put)
# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=http://localhost:5173,https://ludo-arena-ad5.pages.dev

# Server — Supabase (set via `wrangler secret put`, not committed to wrangler.toml)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
