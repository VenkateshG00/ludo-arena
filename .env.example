# Frontend (apps/web/.env.local)
# WebSocket/HTTP server URL — no trailing slash
VITE_SERVER_URL=http://localhost:8787

# Production example:
# VITE_SERVER_URL=https://ludo-arena-server.your-subdomain.workers.dev

# Server (wrangler.toml vars section, or wrangler secret put)
# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://ludo-arena.pages.dev,https://ludo-arena.yourdomain.com
